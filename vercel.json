{
  "experimentalServices": {
    "frontend": {
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "app/main.py",
      "builder": "@vercel/python",
      "runtime": "@vercel/python",
      "routePrefix": "/_/backend"
    }
  },
  "rewrites": [
    {
      "source": "/detect/:path*",
      "destination": "/_/backend/detect/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/_/backend/api/:path*"
    },
    {
      "source": "/events/:path*",
      "destination": "/_/backend/events/:path*"
    },
    {
      "source": "/pos/:path*",
      "destination": "/_/backend/pos/:path*"
    },
    {
      "source": "/stores/:path*",
      "destination": "/_/backend/stores/:path*"
    },
    {
      "source": "/health",
      "destination": "/_/backend/health"
    }
  ]
}
