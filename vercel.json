{
  "experimentalServices": {
    "frontend": {
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "entrypoint": "backend/app/main.py",
      "runtime": "@vercel/python",
      "routePrefix": "/_/backend"
    }
  },
  "rewrites": [
    {
      "source": "/detect/:path*",
      "destination": "/_/backend/detect/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/_/backend/api/:path*"
    }
  ]
}
